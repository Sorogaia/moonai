# ── MoonAi — Environment Variables ──────────────────────────────────────
# Copy this file to .env.local for local dev. NEVER commit real keys.
# Production values live in the Vercel dashboard only.
#
# REQUIRED for any real functionality:
#   ANTHROPIC_API_KEY, HELIUS_API_KEY, UPSTASH_REDIS_REST_*,
#   ALLOWED_ORIGIN, TURNSTILE_SECRET_KEY
#
# OPTIONAL:
#   BETA_PASSWORD, BETA_CODES   — only if you're running a gated beta
#   TELEGRAM_*                  — only for anomaly alerting
# ─────────────────────────────────────────────────────────────────────────

# Anthropic — powers AI chat, narrative, and trenches commentary
ANTHROPIC_API_KEY=sk-ant-...

# Helius — Solana RPC + enhanced transaction data
# Used by: holders, bundles, token-info, fresh-wallets, token-history
HELIUS_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Upstash Redis — distributed rate limiting (per-IP + global daily caps)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# CORS — only requests from this origin will be served
# Production: https://moonaiapp.xyz
# Local dev:  http://localhost:3000
ALLOWED_ORIGIN=https://moonaiapp.xyz

# Cloudflare Turnstile — invisible bot verification for /api/chat
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# The site key is in index.html (public, by design). The secret key below is server-only.
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# ── Beta gate (OPTIONAL — remove or leave unset for an open public site) ──
# Maps invite refs to user names. Used only for audit logs and access tracking.
# Example: BETA_CODES={"abc123":"Alice","def456":"Bob"}
# Without these env vars, the beta gate stays up but rejects all refs (fail-closed).
# To disable the gate entirely for self-hosting: remove the
#   <script src="js/beta.js?v=3"></script>
# and the <div id="beta-gate"> from index.html.
BETA_PASSWORD=changeme-long-random-string
BETA_CODES={"abc123":"Tester"}

# ── Telegram anomaly alerts (OPTIONAL) ────────────────────────────────────
# Notifies you when upstream APIs (Helius, DexScreener) start returning
# malformed responses, which usually means an outage.
# 1. /newbot to @BotFather on Telegram → copy token
# 2. Message your bot once, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    Copy the "id" inside "chat"
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=987654321
