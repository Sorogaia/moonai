# MoonAi — Required Environment Variables
# Copy this file to .env.local for local dev and fill in real values.
# NEVER commit real keys to git. Set production values in Vercel dashboard only.

# Anthropic — powers AI chat
ANTHROPIC_API_KEY=sk-ant-...

# Helius — Solana RPC + enhanced transaction data
HELIUS_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Upstash Redis — distributed rate limiting
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# CORS — allowed frontend origin (no trailing slash)
# Production: https://moonaiapp.xyz
# Local dev:  http://localhost:3000
ALLOWED_ORIGIN=https://moonaiapp.xyz

# Telegram — anomaly alerts (optional but strongly recommended)
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Send any message to your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    Copy the "id" value from "chat" — that is your TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=987654321
